<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:paddingStart="@dimen/tv_overscan_horizontal"
    android:paddingEnd="@dimen/tv_overscan_horizontal"
    android:paddingTop="@dimen/tv_overscan_vertical"
    android:paddingBottom="@dimen/tv_overscan_vertical"
    android:clipToPadding="false"
    android:background="#090A0F">

    <!-- Top App Bar / Modern Unified Header (44dp) -->
    <FrameLayout
        android:id="@+id/layout_header_root"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#090A0F"
        android:paddingHorizontal="12dp">

        <!-- Normal State: Logo + Online Status + Search Button + Menu Button -->
        <LinearLayout
            android:id="@+id/layout_header_normal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- App Brand Logo / Title -->
            <TextView
                android:id="@+id/tv_app_logo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tatap"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- Online Status Badge -->
            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="8dp"
                android:text="Online"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Header Search Toggle Button -->
            <TextView
                android:id="@+id/btn_header_search_toggle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusDown="@+id/btn_tab_musim"
                android:gravity="center"
                android:text="🔍"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <!-- Header Quick Menu Button -->
            <TextView
                android:id="@+id/btn_toggle_menu"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_menu_toggle"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusDown="@+id/btn_tab_musim"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:text="⋮ Menu"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Mode Bar (Expandable full-width in header) -->
        <LinearLayout
            android:id="@+id/layout_search_box"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <!-- Back from search -->
            <TextView
                android:id="@+id/btn_search_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Cari judul anime atau ketik :command..."
                android:textColorHint="#4B5563"
                android:textColor="#F1F5F9"
                android:textSize="12.5sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Clear Search Button -->
            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ProgressBar
                android:id="@+id/pb_loading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:visibility="gone"
                android:indeterminateTint="#38BDF8" />
        </LinearLayout>
    </FrameLayout>

    <!-- Command Execution Feedback Banner -->
    <LinearLayout
        android:id="@+id/layout_command_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_command_banner"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_command_output"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Command OK"
            android:textColor="#38BDF8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_close_command_banner"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Active Filter Badge Bar (Genre, Season, Search) -->
    <LinearLayout
        android:id="@+id/layout_active_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_chip"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_active_filter_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre: Action"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_filter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="✕"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tombol Hapus Semua Riwayat -->
        <TextView
            android:id="@+id/btn_clear_history_all"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_header_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Hapus Semua"
            android:textColor="#EF4444"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Modern Horizontal Scrollable Category Pills Carousel (36dp) -->
    <HorizontalScrollView
        android:id="@+id/layout_tabs_segmented"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_tab_musim"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_active"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusRight="@+id/btn_tab_airing"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🌸 Musim Ini"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_tab_airing"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_musim"
                android:nextFocusRight="@+id/btn_tab_favorit"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="📺 Masih Tayang"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_tab_favorit"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_airing"
                android:nextFocusRight="@+id/btn_tab_katalog"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="⭐ Favorit"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_tab_katalog"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_favorit"
                android:nextFocusRight="@+id/btn_tab_jadwal"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="📚 Katalog"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <!-- Tab Jadwal -->
            <TextView
                android:id="@+id/btn_tab_jadwal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_katalog"
                android:nextFocusRight="@+id/btn_tab_genre"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="⏱️ Jadwal"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <!-- Tab Genre -->
            <TextView
                android:id="@+id/btn_tab_genre"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_jadwal"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🏷️ Genre"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3-Day Schedule Chip Selector (Kemarin, Hari Ini, Besok) - Khusus Mobile Tab Jadwal -->
    <LinearLayout
        android:id="@+id/layout_schedule_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_day_yesterday"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_header_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Kemarin"
            android:textColor="#8892B0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_day_today"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Hari Ini"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_day_tomorrow"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_header_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Besok"
            android:textColor="#8892B0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Section Title & Counter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tayang Musim Ini"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Content Area with Floating Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <!-- Swipe Refresh Layout with Anime Grid & Empty/Error State -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false">

                <!-- Native Grid of Anime Cards -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anime_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="9dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="64dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:scrollbars="vertical" />

                <!-- Empty / Error Placeholder View -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak Ada Anime Ditemukan"
                        android:textColor="#F1F5F9"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Coba gunakan kata kunci lain atau periksa koneksi backend."
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_empty_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_page_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Coba Lagi"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Floating Transparent Pagination Bar -->
        <LinearLayout
            android:id="@+id/layout_pagination"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_floating_pagination"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/btn_prev_page"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_floating_page_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusUp="@+id/rv_anime_grid"
                android:nextFocusRight="@+id/btn_next_page"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Sebelumnya"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_floating_page_indicator"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Hal 1"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_next_page"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_floating_page_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusUp="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_prev_page"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Berikutnya"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
